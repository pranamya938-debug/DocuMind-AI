# DocuMind-AI Configuration Example
# Copy this file to .env and insert your real credentials.

# Google Gemini API Key (Optional for offline fallback mode)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (e.g., gemini-3.8-flash, gemini-3.5-flash-lite, gemini-4-carbon)
GEMINI_MODEL=gemini-3.8-flash

# Maximum File Size in Bytes (Default: 25 MB)
MAX_FILE_SIZE_BYTES=26214400

# Tesseract OCR Executable Path (Optional: defaults to C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# OCR Timeout in Seconds (Default: 15)
OCR_TIMEOUT_SECONDS=15
